# SynChain AI Backend Configuration

# Database URLs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synchain

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ML Engine Path
MODEL_PATH=./ml/models

# Security Keys
API_KEYS=default_sec_api_key_synchain_2026
AI_PROVIDER_KEY=your_gemini_or_openai_api_key_here
JWT_SECRET=synchain_jwt_secret_token_change_in_production
