DATABASE_URL=
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
MODEL_PATH=./ml/models
API_KEYS=
JWT_SECRET=
AI_PROVIDER_KEY=

# Gemini credentials stay on the backend. Existing numbered keys are supported.
# A single GEMINI_API_KEY or comma-separated GEMINI_API_KEYS also works.
# Duplicate keys are removed. AI_PROVIDER_KEY is not treated as a Gemini key.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_REQUEST_DEADLINE_SECONDS=35
GEMINI_MAX_ATTEMPTS=3
GEMINI_COOLDOWN_SECONDS=60
GEMINI_MAX_CONCURRENT_REQUESTS=4
# Local per-process request budget, shared across all keys and AI features.
# Set this below your project's actual model limits; Google also enforces TPM/RPD.
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_MAX_OUTPUT_TOKENS=4096

# Use 587 for required STARTTLS or 465 for implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SynChain AI
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=0.5
# Production account links require HTTPS; local HTTP is permitted.
FRONTEND_URL=http://localhost:5173
